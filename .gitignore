# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/src/generated/prisma

# local file storage (uploads adapter)
/storage/uploads/*
!/storage/uploads/.gitkeep

# database backups
/backups

# editors
.vscode/*
!.vscode/extensions.json
.idea

# vitest
/coverage
