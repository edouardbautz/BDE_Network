# Copy this file to .env and fill in the values below.
# .env holds secrets and machine-specific values — it is never committed.
# Non-secret settings (BDE name, owners, accent color...) live in
# bde.config.yml instead.

# --- Database ---
POSTGRES_USER=bde
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bde_network
# Used by Prisma and by `npm run dev` outside Docker. When the app runs
# inside docker-compose, this is overridden to point at the "postgres"
# service — you don't need to change it for `docker compose up`.
DATABASE_URL="postgresql://bde:change-me@localhost:5432/bde_network?schema=public"

# --- Authentication (NextAuth + 42 OAuth) ---
# At least 32 characters. Generate one with the only tool you need anyway, Docker (any OS):
#   docker run --rm alpine sh -c "head -c 32 /dev/urandom | base64"
AUTH_SECRET=
# Register an OAuth app at https://profile.intra.42.fr/oauth/applications
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=

# --- Email notifications (optional — required only if a notification in
# bde.config.yml is set to "email") ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# With docker-compose.dev.yml these are replaced by Mailpit, a test mailbox on http://localhost:8025
# (docs/notifications.md): no real e-mail is ever sent in development.

# --- Webhook notifications (optional — required only if a notification in
# bde.config.yml is set to "discord" or "slack") ---
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# --- Dev-only role testing (optional) ---
# Lets the real OWNER simulate PENDING/MEMBER/ADMIN from the browser to
# verify access restrictions, via a banner shown on every page. Requires
# BOTH this flag AND a non-production NODE_ENV (set automatically by
# `next dev`) — inert otherwise, no route, no UI, no cookie ever read.
ENABLE_DEV_IMPERSONATION=false

# --- Network exposure of the application (optional) ---
# By default the application only listens on this machine (127.0.0.1), behind a reverse
# proxy that provides HTTPS. Set 0.0.0.0 ONLY if you run without such a proxy: the site
# is then reachable over plain http, which is not safe on a public network.
# See docs/deployment.md, "Sans proxy HTTPS".
APP_BIND=127.0.0.1

# Port on which the application is published on this machine (default 3000). Change it only if
# another program already uses 3000; the 42 redirect URL must then use the same port.
# APP_PORT=3000

# --- Public URL of this instance (optional) ---
# Used to put a link to the event in notifications (confirmation, reminder).
# Leave empty and notifications are sent without a link.
# Example: https://bde.example.org
APP_URL=
