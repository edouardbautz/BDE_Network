# Copy this file to .env and fill in the values below.
# .env holds secrets and machine-specific values — it is never committed.
# Non-secret settings (BDE name, owners, accent color...) live in
# bde.config.yml instead.

# --- Database ---
POSTGRES_USER=bde
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bde_network
# Used by Prisma and by `npm run dev` outside Docker. When the app runs
# inside docker-compose, this is overridden to point at the "postgres"
# service — you don't need to change it for `docker compose up`.
DATABASE_URL="postgresql://bde:change-me@localhost:5432/bde_network?schema=public"

# --- Authentication (NextAuth + 42 OAuth) ---
# Generate with: npx auth secret
AUTH_SECRET=
# Register an OAuth app at https://profile.intra.42.fr/oauth/applications
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=

# --- Email notifications (optional — required only if a notification in
# bde.config.yml is set to "email") ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Webhook notifications (optional — required only if a notification in
# bde.config.yml is set to "discord" or "slack") ---
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# --- Dev-only role testing (optional) ---
# Lets the real OWNER simulate PENDING/MEMBER/ADMIN from the browser to
# verify access restrictions, via a banner shown on every page. Requires
# BOTH this flag AND a non-production NODE_ENV (set automatically by
# `next dev`) — inert otherwise, no route, no UI, no cookie ever read.
ENABLE_DEV_IMPERSONATION=false
