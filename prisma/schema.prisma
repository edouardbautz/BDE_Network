generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Account status. OWNER is granted only via the "owners" list in bde.config.yml, never
/// from the UI, and holds every permission. PENDING users have no access besides the
/// waiting page. MEMBER is an approved account: its rights come from its (single) custom
/// Role. A database check keeps "status = MEMBER" and "roleId is set" in step.
enum UserStatus {
  OWNER
  MEMBER
  PENDING
}

/// A role created by the BDE ("Président", "Trésorier"...): a named set of permissions,
/// given to approved members one at a time. Permission keys are free-form strings checked
/// against the registry in src/lib/permissions (app layer, like module keys), so a future
/// module adds its own without a migration. A key of a module that is not enabled is kept
/// but ignored. `allPermissions` means "everything, including the permissions of modules
/// added later" (the default "Admin" role); the audit log is OWNER-only and never a permission.
model Role {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  permissions    String[] @default([])
  allPermissions Boolean  @default(false)
  /// The role new members are offered at approval and that a former owner falls back to.
  /// Exactly one, and it cannot be deleted.
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users User[]
}

/// A person authenticated through 42 OAuth. Profile fields are resynced from
/// the 42 API on every login. Removing a member from the BDE deletes this row;
/// business/audit records keep the author's login as plain text so history
/// survives the deletion (see AuditLog.actorLogin).
model User {
  id            String     @id @default(cuid())
  /// 42 intra login, e.g. "jdoe"
  login         String     @unique
  fullName      String
  /// Not unique: the login is the identity. 42 can give an address another account already has
  /// (a shared or reassigned mailbox), and that must never stop someone from signing in.
  email         String
  photoUrl      String?
  /// 42 campus name as returned by the intra API, e.g. "Paris"
  campus        String
  /// Optional, entered by the person: how the platform mentions them on Discord and Slack in what it posts for the staff
  /// (their numeric user id and their member id, never a name). Checked by the database too: they end up in a message.
  discordUserId String?
  slackUserId   String?
  status        UserStatus @default(PENDING)
  /// Set exactly when status is MEMBER. RESTRICT: a role still held cannot be deleted.
  roleId        String?
  role          Role?      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  auditLogEntries              AuditLog[]                    @relation("AuditLogActor")
  authoredEvents               Event[]                       @relation("EventAuthor")
  assignedEvents               EventAssignee[]
  assignedOccurrences          EventOccurrenceAssignee[]
  cancelledOccurrences         EventCancellation[]
  notificationTemplates        NotificationTemplate[]        @relation("NotificationTemplateEditor")
  notificationTemplateVersions NotificationTemplateVersion[] @relation("NotificationTemplateVersionAuthor")
  intraRequestsSent            IntraRequest[]                @relation("IntraRequestSender")
  intraRequestsAnswered        IntraRequest[]                @relation("IntraRequestAnswerer")

  /// Secret token of this member's personal .ics subscription feed (events
  /// module). Regenerable from the profile page; null until first generated.
  /// Deleted with the row, so a removed member loses feed access immediately.
  calendarToken String? @unique

  @@index([status])
  @@index([roleId])
}

/// Immutable, append-only record of sensitive actions. Readable by OWNER only,
/// never editable or deletable from the app. actorLogin is kept in plain text
/// so the trail remains meaningful even after the acting user is removed.
model AuditLog {
  id          String   @id @default(cuid())
  actorLogin  String
  actorId     String?
  actor       User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Machine-readable action key, e.g. "member.approve", "member.remove", "permission.grant"
  action      String
  targetType  String
  targetId    String?
  targetLabel String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

/// Who the intra (the school's event form) offers an event to.
enum IntraAudience {
  STUDENTS
  PISCINERS
  BOTH
}

enum EventStatus {
  DRAFT
  /// Submitted for validation by somebody who may propose events but not publish them.
  PROPOSED
  CONFIRMED
}

/// An event planned by the BDE board (events module). A recurring event is a
/// single row — the "series master": occurrences are computed from
/// startsAt/repeat/recurrenceUntil in the BDE timezone, never stored.
/// Authorship follows the AuditLog pattern: authorLogin is plain text so the
/// history survives the author's account being removed.
model Event {
  id                     String         @id @default(cuid())
  title                  String
  description            String?
  location               String?
  /// Key of a category defined in bde.config.yml (events.categories)
  categoryKey            String
  status                 EventStatus    @default(DRAFT)
  /// UTC. For a series, the first occurrence.
  startsAt               DateTime
  /// UTC. endsAt - startsAt is the duration of every occurrence.
  endsAt                 DateTime
  /// How the event repeats: a rule (src/lib/events/repeat.ts: frequency, interval, weekdays, day of the month, count),
  /// read with readRepeatRule. null = the event does not repeat. What a rule leaves out is "like the first date".
  repeat                 Json?
  /// UTC instant after which no occurrence starts: the end date of a series, or the start of the last date of a
  /// series that ends after N dates. null exactly when the event does not repeat (a CHECK the schema cannot express).
  recurrenceUntil        DateTime?
  /// Academic year of startsAt in the BDE timezone, e.g. "2025-2026"
  schoolYear             String
  /// Set once when the "event confirmed" notification went out, so toggling
  /// the status back and forth never notifies twice.
  confirmationNotifiedAt DateTime?
  /// The first row of the series this row was cut from ("this date and the following" splits a series in two
  /// rows). null = this row is its own series. It keeps the UID of every date in the calendar feeds stable.
  seriesId               String?
  /// When the event was last submitted for validation (status PROPOSED), to list the oldest first.
  proposedAt             DateTime?
  /// A validator refused the proposal: the comment the author reads, who wrote it and when. The event is a DRAFT
  /// again; the three are set together (a CHECK the schema cannot express) and cleared when it is proposed or
  /// confirmed. Reasons are kept in the audit log.
  refusalComment         String?
  refusedByLogin         String?
  refusedAt              DateTime?
  /// What the school's staff needs to publish the event on the intra (src/lib/events/intra.ts), all set or none (a
  /// CHECK the schema cannot express: the keywords are never empty when the rest is there). null = not given yet:
  /// an event written before the intra fields, or a platform that does not publish on the intra.
  intraOrganizerLogin    String?
  intraAudience          IntraAudience?
  intraMaxPeople         Int?
  intraWaitingList       Boolean?
  /// One of INTRA_KINDS ("Meet/meet_up"): checked in code, so a kind the intra adds needs no migration.
  intraKind              String?
  /// Hours before the start after which nobody can unsubscribe any more.
  intraUnsubscribeHours  Int?
  intraKeywords          String[]       @default([])
  authorLogin            String
  authorId               String?
  author                 User?          @relation("EventAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  assignees     EventAssignee[]
  cancellations EventCancellation[]
  reminders     EventReminder[]
  occurrences   EventOccurrence[]
  intraRequest  IntraRequest?

  @@index([startsAt])
  @@index([schoolYear])
  @@index([status])
}

/// Where the publication of an event on the intra stands (src/lib/events/intra-request.ts). One row per event (a series is
/// one event: its dates are listed in the request), made when the event is confirmed, answered by the school's staff, and
/// gone when the event goes back to draft or is deleted. `publishedContent` is what the intra holds (a copy of the event's
/// intra content when the staff answered "published"), so that a later change can be shown as the old and the new value.
enum IntraRequestStatus {
  /// Sent, waiting for the staff.
  PENDING
  /// On the intra, and the event has not changed since.
  PUBLISHED
  /// On the intra, and the event changed since: the staff has to update it.
  OUTDATED
  /// The staff refused, with a comment; it can be sent again.
  REFUSED
}

model IntraRequest {
  id               String             @id @default(cuid())
  eventId          String             @unique
  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status           IntraRequestStatus @default(PENDING)
  /// SHA-256 of the intra content of the event as it was last looked at: a sync that finds the same hash changes nothing.
  contentHash      String
  /// What the intra holds, from the moment the staff said it is published (status PUBLISHED or OUTDATED, never otherwise).
  publishedContent Json?
  publishedAt      DateTime?
  /// Optional https link to the event on the intra (intra.42.fr).
  intraUrl         String?
  refusalComment   String?
  requestedAt      DateTime           @default(now())
  /// Who sent it (confirmed the event, or asked again). Plain text next to the key, like AuditLog.actorLogin.
  requestedByLogin String
  requestedById    String?
  requestedBy      User?              @relation("IntraRequestSender", fields: [requestedById], references: [id], onDelete: SetNull)
  /// The staff member who answered (published or refused); null while the request waits.
  answeredAt       DateTime?
  answeredByLogin  String?
  answeredById     String?
  answeredBy       User?              @relation("IntraRequestAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
  @@index([requestedById])
  @@index([answeredById])
}

/// A board member in charge of an event. login is kept in plain text so the
/// assignment still displays after the member's account is removed.
model EventAssignee {
  id      String  @id @default(cuid())
  eventId String
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  login   String

  @@unique([eventId, login])
  @@index([userId])
}

/// One occurrence of a recurring event that was cancelled. occurrenceStart is
/// the occurrence's original start (UTC) as computed from the series.
model EventCancellation {
  id               String   @id @default(cuid())
  eventId          String
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  occurrenceStart  DateTime
  cancelledByLogin String
  cancelledById    String?
  cancelledBy      User?    @relation(fields: [cancelledById], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@unique([eventId, occurrenceStart])
}

/// What one date of a series has of its own ("only this one"). A null column inherits the series; only what was
/// changed is stored, so changing the series later keeps what is specific to this date. occurrenceStart is the
/// date's ORIGINAL start (UTC) as computed from the series, whatever the date was moved to: it is the key, like an
/// iCalendar RECURRENCE-ID. The row is deleted when nothing is left of its own and no notice was claimed.
model EventOccurrence {
  id                     String                    @id @default(cuid())
  eventId                String
  event                  Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  occurrenceStart        DateTime
  title                  String?
  description            String?
  location               String?
  categoryKey            String?
  status                 EventStatus?
  /// A moved date: both or none.
  startsAt               DateTime?
  endsAt                 DateTime?
  /// true: `assignees` replaces the series' members in charge (possibly with nobody).
  assigneesOverridden    Boolean                   @default(false)
  /// Set once when this date was announced on its own (confirmed alone), like Event.confirmationNotifiedAt.
  confirmationNotifiedAt DateTime?
  updatedAt              DateTime                  @updatedAt
  assignees              EventOccurrenceAssignee[]

  @@unique([eventId, occurrenceStart])
}

/// A member in charge of one date, when the date has its own list. login in plain text, like EventAssignee.
model EventOccurrenceAssignee {
  id           String          @id @default(cuid())
  occurrenceId String
  occurrence   EventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  login        String

  @@unique([occurrenceId, login])
  @@index([userId])
}

/// Claim marker for the day-before reminder. The unique index is the lock:
/// only the process whose insert succeeds sends the reminder, which makes
/// delivery at-most-once across restarts and concurrent instances.
model EventReminder {
  id              String   @id @default(cuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  occurrenceStart DateTime
  sentAt          DateTime @default(now())

  @@unique([eventId, occurrenceStart])
}

/// Singleton (id "bde"): the secret token of the BDE-wide .ics subscription
/// feed, meant to be pasted once into the board's shared calendar. null =
/// feed disabled. Unlike User.calendarToken it exposes confirmed events only,
/// never drafts. Regenerating or clearing the token kills the old link at once.
model BdeCalendarFeed {
  id        String   @id @default("bde")
  token     String?  @unique
  updatedAt DateTime @updatedAt
}

/// Singleton (id "platform"): the platform's settings once it is installed: what bde.config.yml
/// and .env used to hold, so that they can be changed from the app without rebuilding or restarting.
/// A row exists exactly when the platform is installed. The values that are secrets (42 client
/// secret, SMTP password, webhook addresses) are sealed in `secrets` with AES-256-GCM
/// (src/lib/settings/crypto.ts); the key lives in the `secrets` Docker volume, never in this database,
/// so a database dump alone does not give them away.
model PlatformSettings {
  id          String   @id @default("platform")
  /// The configuration of the BDE, validated on every load by src/config/schema.ts.
  config      Json
  /// The settings that are not secret and used to be variables of .env (APP_URL, SMTP_HOST...).
  environment Json     @default("{}")
  /// The secret settings, sealed ("v1.<iv>.<tag>.<data>", base64url); null when there are none.
  secrets     String?
  /// Where the settings come from: "import" (bde.config.yml + .env read at the first start of an
  /// installation that predates this table), later "installer" and "settings".
  source      String
  installedAt DateTime
  updatedAt   DateTime @updatedAt
}

/// What a BDE changed of one notification: the current version. Without a row for a (type, scope) the notification is the
/// platform's own (src/lib/notifications/templates). The content is validated by src/lib/notifications/templates/schema.ts when it
/// is saved and again when it is used: a content that is no longer valid is not used, the platform's own is sent instead.
model NotificationTemplate {
  id                 String    @id @default(cuid())
  /// A key of `notifications` of the configuration: eventConfirmed, eventReminder, memberPending...
  type               String
  /// "all" (shared by every channel) or one channel: "discord", "slack", "email". A CHECK of the migration.
  scope              String
  content            Json
  /// Counts the saves of this (type, scope) from 1; NotificationTemplateVersion keeps each.
  version            Int
  /// The revision of the platform's own notification this was written over (templates/revisions.ts): when the
  /// platform's changes, the editor says so, and what the BDE wrote is never replaced.
  basedOnRevision    Int
  updatedAt          DateTime  @updatedAt
  /// Plain text, like every author: the history stays readable after the account is removed.
  updatedByLogin     String
  updatedById        String?
  updatedBy          User?     @relation("NotificationTemplateEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  /// The last time a send found this content unusable and sent the platform's own instead, and why: for the editor to say.
  lastFallbackAt     DateTime?
  lastFallbackReason String?

  @@unique([type, scope])
}

/// Append-only history of NotificationTemplate: one row for each save, reset or restore, never edited. At most 50 are kept
/// for a (type, scope).
model NotificationTemplateVersion {
  id              String   @id @default(cuid())
  type            String
  scope           String
  version         Int
  /// Null for a reset: back to the platform's own.
  content         Json?
  basedOnRevision Int
  /// "save", "reset" or "restore:<version>".
  action          String
  authorLogin     String
  authorId        String?
  author          User?    @relation("NotificationTemplateVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@unique([type, scope, version])
  @@index([type, scope, createdAt])
  @@index([authorId])
}

/// A person, a role or a group of Discord or Slack that a template can mention, under a name a BDE can read: the
/// template says `{@role:bureau}`, this row says which role that is. Without it nobody could write a mention correctly.
model NotificationMention {
  id             String   @id @default(cuid())
  /// The name templates use: lower-case words and numbers joined by dashes. A CHECK of the migration.
  key            String
  /// "discord" or "slack". A CHECK of the migration.
  platform       String
  /// "role" or "user" on Discord, "group" or "user" on Slack. A CHECK of the migration.
  kind           String
  /// What the BDE calls it: "Bureau".
  label          String
  /// The identifier of the platform: a Discord snowflake, a Slack U… or S… identifier.
  externalId     String
  createdByLogin String
  createdAt      DateTime @default(now())

  @@unique([platform, key])
}
